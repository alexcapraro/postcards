{
  "name": "Postcards",
  "short_name": "Postcards",
  "description": "A trip journal: log each day, save places straight from Google Maps, add photos, and turn any day into a postcard.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F1E6D3",
  "theme_color": "#F1E6D3",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Add place",
      "short_name": "Add place",
      "url": "./?go=add",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Make today's postcard",
      "short_name": "Postcard",
      "url": "./?go=postcard",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mailbox",
      "short_name": "Mailbox",
      "url": "./?go=mailbox",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
